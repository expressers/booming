{
  "northStar": "A Descida",
  "motion": {
    "ease-out": "cubic-bezier(0.23, 1, 0.32, 1)",
    "ease-in-out": "cubic-bezier(0.77, 0, 0.175, 1)",
    "press": "transform 160ms var(--ease-out)",
    "heroLines": "SplitText lines, yPercent 105 to 0, 1.1s expo.out, stagger 0.09",
    "wipe": "clip-path inset left to right, scrubbed top 88% to top 55%",
    "descent": "ScrollTrigger progress 0..1 from page top to #cotacao, Lenis on the GSAP ticker"
  },
  "breakpoints": { "md": "768px", "portraitScene": "aspect < 0.85" },
  "shadows": {},
  "rules": [
    "The Only Light Rule: lime only for light sources and the primary action.",
    "The No Kicker Rule: no eyebrow labels above headings.",
    "Dark only; text over the scene sits on a navy scrim."
  ],
  "components": {
    "button-primary": {
      "html": "<a class=\"btn btn-primary\" href=\"#cotacao\">Pedir cotação</a>",
      "css": ".btn{display:inline-flex;align-items:center;gap:.6rem;height:3.25rem;padding:0 1.4rem;border-radius:4px;font-family:Lufga,Ubuntu,sans-serif;font-weight:500;white-space:nowrap;transition:transform 160ms cubic-bezier(.23,1,.32,1),background-color 200ms ease}.btn:active{transform:scale(.97)}.btn-primary{background:#91d336;color:#192730}"
    },
    "input": {
      "html": "<label>Nome<input class=\"field\"></label>",
      "css": ".field{width:100%;height:3.25rem;padding:0 1rem;border-radius:4px;border:1px solid rgba(230,230,230,.22);background:#111c23;color:#e6e6e6}.field:focus-visible{outline:none;border-color:#91d336}"
    }
  }
}
